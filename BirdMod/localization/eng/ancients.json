{
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.0-0r.char": "[outline_size=8][outline_color=white][color=#000000][jitter]Chirp![/jitter][/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.0-1r.ancient": "...Begone, creature. You bother me.",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.0-attack": "Architect",
  
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-0.char": "[outline_size=8][outline_color=white][color=#000000]...[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-0.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-1.ancient": "...Why are you even here?",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-1.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-2.char": "[outline_size=8][outline_color=white][color=#000000][jitter]T-Tribe... fallen to m-monsters...[/jitter][/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-2.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-3.char": "[outline_size=8][outline_color=white][color=#000000][jitter]T-That's... that's your fault, isn't it?[/jitter][/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-3.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-4.ancient": "And if it is? What are [sine]you[/sine] going to do about it?",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-4.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-5.char": "[outline_size=8][outline_color=white][color=#000000][jitter]I-I...\nSqueak...[/jitter][/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-5.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-6.ancient": "Hmph.",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.1-attack": "Architect",
  
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-0.char": "[outline_size=8][outline_color=white][color=#000000]...C-Can't you bring them back?[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-0.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-1.ancient": "...Why would I do that?",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-1.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-2.char": "[outline_size=8][outline_color=white][color=#000000][jitter]I-I...[/jitter] just want to go home...[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-2.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-3.ancient": "...You will never go home.",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-3.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-4.char": "[outline_size=8][outline_color=white][color=#000000][shake rate=30.0 level=8 connected=0]...!!![/shake][/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.2-attack": "Both",

  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-0.char": "[outline_size=8][outline_color=white][color=#000000]...What could possibly be so important?",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-0.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-1.ancient": "What was that?",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-1.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-2.char": "[outline_size=8][outline_color=white][color=#000000]As in... what are you reading, each time I arrive?[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-2.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-3.char": "[outline_size=8][outline_color=white][color=#000000]Is it so important as to kill me?[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-3.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-4.ancient": "My work is very important.",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-4.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-5.char": "[outline_size=8][outline_color=white][color=#000000]You mean... reading?[/color][/outline_color][/outline_size]",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-5.next": "Continue",
  "THE_ARCHITECT.talk.BIRDMOD_BIRD_MOD.3-6.ancient": "Yes. Which is what you are stopping me from doing.",
  "THE_ARCHITECT.talk.BIRDMOD-BIRD_MOD.3-attack": "Both",
  


  "NEOW.talk.BIRDMOD-BIRD_MOD.0-0.char": "...Chirp?",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-0.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-1.ancient": "[sine]...from... outside...?[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-1.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-2.ancient": "[sine]...go... climb...[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-2.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.0-3.ancient": "[sine]......take.. my power.... [/sine]",
  
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-0.ancient": "[sine]..climb.... again..[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-0.next": "Question",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-1.char": "[i]She questions why.[/i]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-1.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-2.ancient": "[sine]..the.. [jitter][red]ARCHITECT[/red][/jitter]....[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-2.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.1-3.char": "[i]She nods.[/i]",
  
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-0.char": "[i]She chirps angrily.[/i]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-0.next": "Question Again",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-1.ancient": "[sine]...bring ..tribe... .back...?[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-1.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-2.ancient": "[sine].no.. ascending... spirit...[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-2.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.2-3.ancient": "[sine]...you must.. climb... to.. [jitter][red]ARCHITECT[/red][/jitter]...[/sine]",

  "NEOW.talk.BIRDMOD-BIRD_MOD.3-0.char": "...",
  "NEOW.talk.BIRDMOD-BIRD_MOD.3-0.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.3-1.ancient": "[sine]..don't you...want.. to go home..?[/sine]",
  "NEOW.talk.BIRDMOD-BIRD_MOD.3-1.next": "",
  "NEOW.talk.BIRDMOD-BIRD_MOD.3-2.ancient": "[sine]...kill... the... [jitter][red]ARCHITECT[/red][/jitter]...[/sine]",
  
  
  "DARV.talk.BIRDMOD-BIRD_MOD.0-0.ancient": "[i]Darv ignores the Bird as she arrives, sorting through his collection.[/i]",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-0.next": "Get his attention",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-1.char": "[i]She chirps and waves[/i]",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-1.next": "",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-2.ancient": "[i]Darv glances at the Bird, then turns to face her with a grin.[/i]",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-2.next": "",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-3.ancient": "Ah, sorry 'bout that. Didn't realize you weren't part of the rabble.",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-3.next": "",
  "DARV.talk.BIRDMOD-BIRD_MOD.0-4.ancient": "Come here! Find somethin' special to take with ya.",
  
  "DARV.talk.BIRDMOD-BIRD_MOD.1-0r.char": "Squeak!",
  "DARV.talk.BIRDMOD-BIRD_MOD.1-0r.next": "",
  "DARV.talk.BIRDMOD-BIRD_MOD.1-1r.ancient": "You're back! Welcome, welcome!",
  "DARV.talk.BIRDMOD-BIRD_MOD.1-1r.next": "",
  "DARV.talk.BIRDMOD-BIRD_MOD.1-2r.ancient": "Have a look around. Take anythin' that catches your eye!",
  "DARV.talk.BIRDMOD-BIRD_MOD.1-visit": "2",
  
  
  
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.0-0.ancient": "Oh, a beautiful creature enters my domain!",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.0-0.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.0-1.char": "[i]She blushes, stepping forward...[/i]",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.0-1.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.0-2.ancient": "Come forth, and receive my gifts.",
  
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-0.ancient": "...Hm? What's wrong, dear? Your expression looks so somber.",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-0.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-1.char": "[i]She looks away.[/i]",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-1.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-2.ancient": "Servants, pull up a chair. Rest for a moment before your arduous ascent resumes.",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.1-visit": "2",
  
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.2-0r.ancient": "Welcome, small one! My royal gifts await you.",

  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-0.char": "[i]She asks about the Signet Ring.[/i]",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-0.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-1.ancient": "Ah, my Ring! It was a gift from my first suitor.",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-1.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-2.ancient": "It's quite valuable, created from pure gold. Only the best for royalty of my prestige.",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-2.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.3-3.ancient": "...And now, it can be yours, if you so desire.",
  
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-0.char": "[i]She prepares herself...[/i]",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-0.next": "Proceed",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-1.ancient": "My champion returns! Come, small one, and allow me to bless thee.",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-1.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-2.char": "[i]She lets out a few flirtatious chirps[/i].",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-2.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-3.ancient": "[sine]Oh my![/sine] I'm honored to be revered by such a noble soul...",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-3.next": "",
  "NONUPEIPE.talk.BIRDMOD-BIRD_MOD.4-4.ancient": "After the Architect is defeated, come back to me, and I'll have my servants prepare [sine]only the best[/sine] tea for us...",
  
  
  "VAKUU.talk.BIRDMOD-BIRD_MOD.0-0.ancient": "Ahh, another puppet. In more ways than one.",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.0-0.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.0-1.char": "...?",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.0-1.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.0-2.ancient": "Oh, don't mind me. Just sign here and here and here and...",
  
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-0.ancient": "You believe in such... [sine]vague[/sine] things.",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-0.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-1.ancient": "I'm right here. Physically. In front of you. Why not believe in me instead?",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-1.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-2.ancient": "Or do you really cling to those fantasies that you've been taught too tightly to believe anything else?",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-2.next": "Ignore",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-3.char": "[i]She doesn't respond.[/i]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-3.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.1-4.ancient": "...[jitter]Hmph.[/jitter] Just pick a contract and sign already.",
  
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-0.char": "...y-...",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-0.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-1.ancient": "Huh? What was that? [jitter]Speak up![/jitter]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-1.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-2.char": "[i]She hesitates, then looks away.[/i]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-2.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-3.ancient": "...Whatever. You know, I don't give out my [sine]good[/sine] deals to WEAKLINGS.",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-3.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.2-4.ancient": "Sign this and prove yourself, [jitter]puppet[/jitter].",
  
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-0.char": "You're wrong.",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-0.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-1.ancient": "I'm [jitter]WRONG?[/jitter]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-1.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-2.char": "Y-You... You're wrong about me! You're wrong about my Ancestors!",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-2.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-3.char": "Your insidious lies... t-they're all wrong!",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-3.next": "ATTACK HIM",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-4.char": "[i]She lashes out at the demon![/i]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-4.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-5.ancient": "[i]Vakuu howls in pain.[/i]",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-5.next": "",
  "VAKUU.talk.BIRDMOD-BIRD_MOD.3-6.ancient": "[jitter][red]GGRAH!![/red][/jitter] INSIPID VERMIN! SIGN, THEN GET OUT OF MY SIGHT!",
  
  "VAKUU.talk.BIRDMOD-BIRD_MOD.4-0r.char": "Pick, then leave."
}